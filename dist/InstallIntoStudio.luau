	local statusLabel = newLabel(panel, "Status", BOLD, 18)
	statusLabel.Position = UDim2.new(0, 20, 0, 140)
	statusLabel.Size = UDim2.new(1, -40, 0, 26)
	statusLabel.TextColor3 = COLORS.status

