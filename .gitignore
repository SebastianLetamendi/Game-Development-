# Tools downloaded by tools/install-dev-tools.sh and files generated by tools/check.sh
.tools/
sourcemap.json
__pycache__/

# Roblox place files and Studio lock files. Keep place backups outside this
# repository (see docs/SETUP.md); the scripts in src/ are the source of truth.
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Blender automatic backups (keep the .blend source itself if it is small)
*.blend1
*.blend@

# Screen recordings and video exports are large; store them outside Git.
recordings/
exports/
*.mov
*.mp4
*.mkv

# Secrets must never be committed. This repository is public.
.env
.env.*
*.pem
*.key

# OS and editor clutter
.DS_Store
.vscode/*.log
